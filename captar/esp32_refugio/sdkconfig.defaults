# ESP32-S3 N16R8: flash 16 MB, PSRAM octal 8 MB
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Consola por USB-Serial-JTAG nativo -> /dev/ttyACM0 (115200 es nominal en USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Los logs comparten el canal con el JSON: solo errores (el puente ignora lo que no es JSON)
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
